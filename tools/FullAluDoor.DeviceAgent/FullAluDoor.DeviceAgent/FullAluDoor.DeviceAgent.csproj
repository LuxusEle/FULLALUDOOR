<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FullAluDoor.DeviceAgent</AssemblyName>
    <RootNamespace>FullAluDoor.DeviceAgent</RootNamespace>
    <Version>1.0.0</Version>
    <Product>FullAluDoor Device Agent</Product>
    <Description>Windows device identity + attestation helper for the FullAluDoor hybrid device-bound authentication system.</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- The agent is a Windows-only helper (DPAPI, registry, loopback service). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI (CryptProtectData) for Windows-protected storage of the Ed25519 seed. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <!-- HKCU Run-key autostart for non-admin user-level install. -->
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <!-- Pure-managed Ed25519 (RFC 8032) key generation/signing/verification. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.4.0" />
  </ItemGroup>

</Project>
